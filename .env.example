APP_NAME=anuvia
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Local development, SQLite, no setup needed
DATABASE_URL=sqlite+aiosqlite:///./local.db

# Production: Neon PostgreSQL. Take the dashboard string and make two edits:
# change the scheme to postgresql+asyncpg://, and drop the query params,
# asyncpg rejects sslmode/channel_binding; SSL is set in app/core/database.py.
# DATABASE_URL=postgresql+asyncpg://user:password@ep-xxx.us-east-1.aws.neon.tech/dbname

# Browser origins allowed to call this API. "*" for any, or a comma-separated
# list. "*" is right locally and wrong in production. For Playroom, set it to
# the frontend's Cloud Run URL and http://localhost:3000.
CORS_ALLOW_ORIGINS=*

# Playroom rooms API (app/apps/playroom)
# Bearer token the retention sweeper at POST /games/v1/maintenance/sweep
# requires. Leave empty to disable that endpoint: the safe default. Required
# in production if you schedule the sweep. Any long random string.
PLAYROOM_MAINTENANCE_TOKEN=
# Hours a room stays reachable after its last change. Default 2. The client's
# "How to play" copy states two hours, so change both together.
PLAYROOM_ROOM_TTL_HOURS=2
# Days before the sweeper drops nicknames, boards and selections. Default 7.
PLAYROOM_RETENTION_DAYS=7

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Set automatically by the deploy workflow (UTC, ISO-8601). Leave empty locally.
# /health renders it in IST so you can confirm a deploy without opening GitHub.
DEPLOYED_AT=
